# /etc/systemd/system/devexcode.service
#
# Runs the standalone Next.js server produced by deploy/release.sh.
# WorkingDirectory is the "current" symlink, which deploy.yml swaps atomically,
# so a restart always picks up the newest release and a rollback is a symlink
# change plus a restart.
[Unit]
Description=DevExCode (Next.js standalone)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/devexcode/current
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
# Secrets (MONGODB_URI, NEXTAUTH_SECRET, ...) live here, root-owned, chmod 600.
# Never commit them.
EnvironmentFile=/srv/devexcode/shared/.env

# The app only ever reads its own release directory and writes nothing outside it.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/devexcode

StandardOutput=journal
StandardError=journal
SyslogIdentifier=devexcode

[Install]
WantedBy=multi-user.target
